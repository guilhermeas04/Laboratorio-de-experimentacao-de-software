{
  "issue": 121,
  "repository_count": 300,
  "factors": [
    {
      "factor": "language",
      "label": "Linguagem principal",
      "hypothesis": "A distribuicao de cada metrica difere entre linguagens. Ecossistemas tem cadencias de release e praticas de CI diferentes."
    },
    {
      "factor": "stars_quartile",
      "label": "Popularidade (quartis de estrelas)",
      "hypothesis": "Repositorios mais populares publicam com mais frequencia e falham menos no CI, porque tem mais revisao e automacao."
    },
    {
      "factor": "contributors_quartile",
      "label": "Contribuidores (quartis)",
      "hypothesis": "Mais contribuidores aumentam a frequencia de deploy e tambem as falhas de CI, por haver mais mudancas concorrentes."
    },
    {
      "factor": "age_quartile",
      "label": "Idade do repositorio (quartis)",
      "hypothesis": "Repositorios mais antigos sao mais estaveis: CFR menor e recuperacao mais rapida, mas lead time maior."
    }
  ],
  "metrics": [
    {
      "metric": "deployment_frequency_per_week",
